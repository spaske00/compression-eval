#!/bin/bash

set -euo pipefail

dt=$(date +%s)
corpus="${1:-corpus}"
out="$PWD/results_$dt.csv"

if [[ ! -d "$corpus" ]]; then
    echo "Corpus directory not found: $corpus" >&2
    exit 1
fi

search_path="."
corpus="$(cd "$corpus" && pwd)"
if [[ -d "$corpus/bin" ]]; then
    search_path="./bin"
fi

pushd "$corpus" >/dev/null

mapfile -d '' files < <(find "$search_path" -type f -executable -print0 | sort -z)

if (( ${#files[@]} == 0 )); then
    echo "No executables found under $corpus/$search_path" >&2
    exit 1
fi

"${LZBENCH_EXE:-lzbench}" -o4c7 "${files[@]}" | tee "$out"

popd >/dev/null
