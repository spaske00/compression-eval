#!/bin/bash

set -euo pipefail

timestamp="$(date +%s)"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
corpus_dir="${1:-$script_dir/corpus}"

if [[ ! -d "$corpus_dir" ]]; then
    echo "Corpus directory not found: $corpus_dir" >&2
    exit 1
fi

corpus_dir="$(cd "$corpus_dir" && pwd)"
archive="$corpus_dir/nexus-$timestamp.zip"

if [[ ! -d "$corpus_dir/bin" ]]; then
    echo "Corpus bin directory not found: $corpus_dir/bin" >&2
    exit 1
fi

cd "$corpus_dir"

echo "Creating archive: $archive"
zip -r "$archive" bin
echo "Created $archive from $corpus_dir/bin"
