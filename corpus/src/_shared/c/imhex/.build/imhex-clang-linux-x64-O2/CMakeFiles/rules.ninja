rule CXX_STATIC_LIBRARY_LINKER__libdisassembler_None
  command = $PRE_LINK && /opt/cmake-3.31.10-linux-x86_64/bin/cmake -E rm -f $TARGET_FILE && /usr/bin/ar qc $TARGET_FILE $LINK_FLAGS $in && /usr/bin/ranlib $TARGET_FILE && $POST_BUILD
  description = Linking CXX static library $TARGET_FILE
  restat = $RESTAT


