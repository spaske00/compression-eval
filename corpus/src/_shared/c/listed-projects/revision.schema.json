{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Listed native corpus revision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "input_url", "canonical_url", "source_directory", "commit", "nested_submodules"],
  "properties": {
    "schema_version": {"const": 1},
    "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "input_url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": "string", "format": "uri"},
    "source_directory": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/upstream$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "nested_submodules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "commit"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
        }
      }
    }
  }
}
