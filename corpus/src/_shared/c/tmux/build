#!/usr/bin/env bash
set -euo pipefail
if (( $# < 3 )); then exit 2; fi; cc=$1; cxx=$2; raw=$3; shift 3; flags=("$@"); target=${raw%.out}
case "$target" in ""|.|..|*/*) exit 2;; esac; case "$(basename "$cc"):$(basename "$cxx")" in gcc*:g++*|clang*:clang++*) ;; *) exit 2;; esac
root=$(cd "$(dirname "$0")" && pwd); b="$root/.build/$target"; src="$b/source"; tmp="$root/bin/.$target.tmp"; out="$root/bin/$target"; trap 'rm -rf -- "$tmp"' EXIT; rm -rf "$b" "$tmp" "$out"; mkdir -p "$src" "$tmp"
git -C "$root/upstream" archive HEAD | tar -xf - -C "$src"; (cd "$src"; sh autogen.sh; CC="$cc" CFLAGS="${flags[*]}" LDFLAGS="${flags[*]}" ./configure; make -j"${JOBS:-8}" CC="$cc" CFLAGS="${flags[*]}" LDFLAGS="${flags[*]}" tmux)
artifact="$src/tmux"; test -s "$artifact" -a -x "$artifact"; test "$(dd if="$artifact" bs=4 count=1 status=none)" = "$(printf '\177ELF')"; cp "$artifact" "$tmp/$target"; chmod u+x "$tmp/$target"; mv -T "$tmp" "$out"; trap - EXIT
