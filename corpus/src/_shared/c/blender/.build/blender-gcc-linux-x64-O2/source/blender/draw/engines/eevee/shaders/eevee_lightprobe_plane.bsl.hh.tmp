  int _select_probe(eevee_LightprobePlaneRenderData  this_, float3 P, float3 N)
  {
    float best_score = 0.0;
    int best_index = -1;

    for (int index = 0; index < PLANAR_PROBE_MAX; index++) {
      if (probe_planar_buf[index].layer_id == -1) {

        break;
      }
      float score = eevee_LightprobePlaneRenderData_probe_score(probe_planar_buf[index], P, N);
      if (score > best_score) {
        best_score = score;
        best_index = index;
      }
    }
    return best_index;
  }
#endif
#line 55
         float eevee_LightprobePlaneRenderData_distance_score(PlanarProbeData planar, float3 P)
  {
    float3 lP = float4(P, 1.0f) * planar.world_to_object_transposed;

    return float(all(lessThan(abs(lP), float3(1.0f))));
  }
#line 62
         float eevee_LightprobePlaneRenderData_probe_score(PlanarProbeData planar, float3 P, float3 N)
  {
    return saturate(dot(N, planar.normal)) * eevee_LightprobePlaneRenderData_distance_score(planar, P);
  }
