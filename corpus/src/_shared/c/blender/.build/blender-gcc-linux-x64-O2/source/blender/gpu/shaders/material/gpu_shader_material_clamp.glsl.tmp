void clamp_minmax(float value, float min_allowed, float max_allowed, _ref(float ,result))
{
  result = min(max(value, min_allowed), max_allowed);
}
#line 18
void clamp_range(float value, float min, float max, _ref(float ,result))
{
  result = (max > min) ? clamp(value, min, max) : clamp(value, max, min);
}
