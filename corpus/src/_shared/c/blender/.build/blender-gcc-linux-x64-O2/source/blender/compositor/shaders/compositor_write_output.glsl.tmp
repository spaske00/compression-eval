void main()
{
  int2 texel = int2(gl_GlobalInvocationID.xy);
  int2 output_texel = texel + lower_bound;
  if (any(greaterThan(output_texel, upper_bound))) {
    return;
  }

  imageStore(output_img, texel + lower_bound, texture_load(input_tx, texel));
}
