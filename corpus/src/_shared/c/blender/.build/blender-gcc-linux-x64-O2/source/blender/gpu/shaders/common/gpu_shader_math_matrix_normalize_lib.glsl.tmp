#if defined(GPU_OPENGL) || defined(GPU_METAL)
float2 normalize(float2 a)
{
  return a * inversesqrt(length_squared(a));
}
float3 normalize(float3 a)
{
  return a * inversesqrt(length_squared(a));
}
float4 normalize(float4 a)
{
  return a * inversesqrt(length_squared(a));
}
