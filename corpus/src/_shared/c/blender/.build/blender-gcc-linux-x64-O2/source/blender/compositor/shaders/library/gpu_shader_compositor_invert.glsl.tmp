#line 1 "gpu_shader_compositor_invert.glsl"
 
#line 8
void node_composite_invert(
    float4 color, float factor, float invert_color, float invert_alpha, _ref(float4 ,result))
{
  result = color;
  if (invert_color != 0.0f) {
    result.rgb = 1.0f - result.rgb;
  }
  if (invert_alpha != 0.0f) {
    result.a = 1.0f - result.a;
  }
  result = mix(color, result, factor);
}
