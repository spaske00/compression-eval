void valtorgb_nearest(
    float fac, sampler1DArray colormap, float layer, _ref(float4 ,outcol), _ref(float ,outalpha))
{
  fac = clamp(fac, 0.0f, 1.0f);
  outcol = texelFetch(colormap, int2(fac * (textureSize(colormap, 0).x - 1), layer), 0);
  outalpha = outcol.a;
}
