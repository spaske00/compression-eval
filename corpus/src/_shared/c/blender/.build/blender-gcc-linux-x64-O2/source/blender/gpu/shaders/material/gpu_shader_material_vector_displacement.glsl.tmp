#line 1 "gpu_shader_material_vector_displacement.glsl"
 
#line 9
void node_vector_displacement_tangent(
    float4 vector, float midlevel, float scale, float4 T, _ref(float3 ,result))
{
  float3 oN, oT, oB;
  normal_transform_world_to_object(g_data.N, oN);
  normal_transform_world_to_object(T.xyz, oT);
  oN = normalize(oN);
  oT = normalize(oT);
  oB = T.w * safe_normalize(cross(oN, oT));

  float3 disp = (vector.xyz - midlevel) * scale;
  disp = disp.x * oT + disp.y * oN + disp.z * oB;
  direction_transform_object_to_world(disp, result);
}
#line 25
void node_vector_displacement_object(float4 vector, float midlevel, float scale, _ref(float3 ,result))
{
  float3 disp = (vector.xyz - midlevel) * scale;
  direction_transform_object_to_world(disp, result);
}
#line 32
void node_vector_displacement_world(float4 vector, float midlevel, float scale, _ref(float3 ,result))
{
  result = (vector.xyz - midlevel) * scale;
}
