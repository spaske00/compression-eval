bool is_unit_scale(float2 v)
{
  constexpr float assert_unit_epsilon = 0.0002f;
  float test_unit = dot(v, v);
  return (!(abs(test_unit - 1.0f) >= assert_unit_epsilon) ||
          !(abs(test_unit) >= assert_unit_epsilon));
}
