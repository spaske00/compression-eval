  void _radiance_transfer_surfel(eevee_surfel_SurfelRay  this_, _ref(Surfel ,receiver), Surfel sender)
  {
#line 70
    float3 L = safe_normalize(sender.position - receiver.position);
    bool front_facing = dot(-L, sender.normal) > 0.0f;

    float4 radiance_vis;
    SurfelRadiance sender_radiance_indirect = sender.radiance_indirect[srt_access(eevee_surfel_SurfelRay, radiance_src)];
    if (front_facing) {
      radiance_vis = sender.radiance_direct.front;
      radiance_vis += sender_radiance_indirect.front * sender_radiance_indirect.front_weight;
    }
    else {
      radiance_vis = sender.radiance_direct.back;
      radiance_vis += sender_radiance_indirect.back * sender_radiance_indirect.back_weight;
    }

    if (!srt_access(SurfelData, capture_info_buf).capture_indirect) {
      radiance_vis.rgb = float3(0.0f);
    }

    _radiance_transfer(this_, receiver, radiance_vis.rgb, radiance_vis.a, L);
  }
#endif

