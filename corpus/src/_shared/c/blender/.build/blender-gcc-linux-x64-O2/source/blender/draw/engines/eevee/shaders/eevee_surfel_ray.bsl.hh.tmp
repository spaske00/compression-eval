    SurfelRadiance radiance = surfel.radiance_indirect[srt_access(eevee_surfel_SurfelRay, radiance_dst)];

    float sample_weight = 1.0f / srt_access(SurfelData, capture_info_buf).sample_count;
    bool front_facing = (NL > 0.0f);
