#if defined(CREATE_INFO_workbench_color_Materials)
#line 14
  void _material_data_get(workbench_color_Materials  this_, int handle,
                         float3 vertex_color,
                         _ref(float3 ,color),
                         _ref(float ,alpha),
                         _ref(float ,roughness),
                         _ref(float ,metallic))
  {
    float4 data = materials_data[handle];
    color = (data.r == -1) ? vertex_color : data.rgb;

    uint encoded_data = floatBitsToUint(data.w);
    alpha = float((encoded_data >> 16u) & 0xFFu) * (1.0f / 255.0f);
    roughness = float((encoded_data >> 8u) & 0xFFu) * (1.0f / 255.0f);
    metallic = float(encoded_data & 0xFFu) * (1.0f / 255.0f);
  }
#endif
       workbench_color_Materials workbench_color_Materials_new_()
{
  workbench_color_Materials result;
  result._pad = 0;
  return result;
