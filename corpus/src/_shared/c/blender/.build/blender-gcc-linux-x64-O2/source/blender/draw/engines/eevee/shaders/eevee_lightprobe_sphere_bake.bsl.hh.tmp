float eevee_lightprobe_sphere_triangle_solid_angle(float3 A, float3 B, float3 C)
{
  return 2.0f * atan(abs(dot(A, cross(B, C))), (1.0f + dot(B, C) + dot(A, C) + dot(A, B)));
}

float eevee_lightprobe_sphere_quad_solid_angle(float3 A, float3 B, float3 C, float3 D)
{
  return eevee_lightprobe_sphere_triangle_solid_angle(A, B, C) + eevee_lightprobe_sphere_triangle_solid_angle(C, B, D);
}

