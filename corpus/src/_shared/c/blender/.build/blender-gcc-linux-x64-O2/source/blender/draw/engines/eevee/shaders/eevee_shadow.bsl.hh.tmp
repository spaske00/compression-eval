#line 28
  float _read_depth(eevee_ShadowRenderData  this_, ShadowCoordinates coord)
  {
    ShadowSamplingTile tile = shadow_tile_load(
        srt_access(eevee_ShadowRenderData, shadow_tilemaps_tx), coord.tilemap_tile, coord.tilemap_index);
    if (!tile.is_valid) {
      return -1.0f;
    }

    constexpr uint page_shift = uint(SHADOW_PAGE_LOD);
    constexpr uint page_mask = ~(0xFFFFFFFFu << uint(SHADOW_PAGE_LOD));

    uint2 texel = coord.tilemap_texel;

    texel += uint2(tile.lod_offset << SHADOW_PAGE_LOD);

    uint2 texel_page = (texel >> tile.lod) & page_mask;
    texel = (uint2(tile.page.xy) << page_shift) | texel_page;

    return uintBitsToFloat(texelFetch(srt_access(eevee_ShadowRenderData, shadow_atlas_tx), int3(int2(texel), int(tile.page.z)), 0).r);
  }
#endif

#if defined(CREATE_INFO_eevee_ShadowRenderData)
#line 49
  float _punctual_sample_get(eevee_ShadowRenderData  this_, LightData light, float3 P)
  {
    float3 shadow_position = _local(light).local.shadow_position;
    float3 lP = transform_point_inversed(light.object_to_world, P);
    lP -= shadow_position;
    int face_id = shadow_punctual_face_index_get(lP);
    lP = shadow_punctual_local_position_to_face_local(face_id, lP);
    ShadowCoordinates coord = shadow_punctual_coordinates(light, lP, face_id);

    float radial_dist = _read_depth(this_, coord);
    if (radial_dist == -1.0f) {
      return 1e10f;
    }
    float receiver_dist = length(lP);
    float occluder_dist = radial_dist;
    return receiver_dist - occluder_dist;
  }
#endif

#if defined(CREATE_INFO_eevee_ShadowRenderData)
#line 67
  float _directional_sample_get(eevee_ShadowRenderData  this_, LightData light, float3 P)
  {
    float3 lP = transform_direction_transposed(light.object_to_world, P);
    ShadowCoordinates coord = shadow_directional_coordinates(light, lP);

    float depth = _read_depth(this_, coord);
    if (depth == -1.0f) {
      return 1e10f;
    }

    float receiver_dist = -lP.z - orderedIntBitsToFloat(light.clip_near);
    float occluder_dist = depth;
    return receiver_dist - occluder_dist;
  }
#endif

#if defined(CREATE_INFO_eevee_ShadowRenderData)
#line 82
  float _shadow_sample(eevee_ShadowRenderData  this_, const bool is_directional, LightData light, float3 P)
  {
    if (is_directional) {
      return _directional_sample_get(this_, light, P);
    }
    return _punctual_sample_get(this_, light, P);
  }
#endif
       eevee_ShadowRenderData eevee_ShadowRenderData_new_()
