float4 clip_line_point_homogeneous_space(float4 p, float4 q)
{
  if (p.z < -p.w) {

    float denom = q.z - p.z + q.w - p.w;
    if (denom == 0.0f) {

      return p;
    }
    float A = (-p.z - p.w) / denom;
    p = p + (q - p) * A;
  }
  return p;
}

