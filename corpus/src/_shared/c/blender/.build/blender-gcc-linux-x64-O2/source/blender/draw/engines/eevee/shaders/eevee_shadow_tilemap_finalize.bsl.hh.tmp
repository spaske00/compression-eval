int eevee_shadow_viewport_select(int2 rect_size)
{

  int max_dim = max(rect_size.x, rect_size.y);

  int power_of_two = findMSB(uint(max_dim));
  if ((1 << power_of_two) != max_dim) {
    power_of_two += 1;
  }
  return power_of_two;
}

