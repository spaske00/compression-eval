#line 51
              bool is_area_light(eLightType type)
{
  return type >= LIGHT_RECT;
}

              bool is_point_light(eLightType type)
{
  return type >= LIGHT_OMNI_SPHERE && type <= LIGHT_SPOT_DISK;
}

              bool is_spot_light(eLightType type)
{
  return type == LIGHT_SPOT_SPHERE || type == LIGHT_SPOT_DISK;
}

              bool is_sphere_light(eLightType type)
{
  return type == LIGHT_SPOT_SPHERE || type == LIGHT_OMNI_SPHERE;
}

              bool is_oriented_disk_light(eLightType type)
{
  return type == LIGHT_SPOT_DISK || type == LIGHT_OMNI_DISK;
}

              bool is_sun_light(eLightType type)
{
  return type < LIGHT_OMNI_SPHERE;
}

              bool is_local_light(eLightType type)
{
  return type >= LIGHT_OMNI_SPHERE;
}
