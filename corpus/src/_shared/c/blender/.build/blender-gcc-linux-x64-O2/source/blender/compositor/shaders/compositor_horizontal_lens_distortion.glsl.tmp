#line 16
  float2 normalized_texel = (float2(texel) + float2(0.5f)) / float2(texture_size(input_tx));
#line 19
  const float4 red = texture(input_tx, normalized_texel + float2(dispersion, 0.0f));
  const float4 green = texture_load(input_tx, texel);
