#line 134
float3 gbuffer_closure_data_dither_round_to_nearest(float3 data, float3 noise)
{
  constexpr float quantization_step = 1.0f / 1023.0f;
  return saturate(data + (noise - 0.5f) * quantization_step);
}

float4 gbuffer_closure_data_dither_round_to_nearest(float4 data, float3 noise)
{
  return float4(gbuffer_closure_data_dither_round_to_nearest(data.rgb, noise), data.a);
}
#line 146
float3 gbuffer_closure_data_dither_flush_to_zero(float3 data, float3 noise)
{
  constexpr float quantization_step = 1.0f / 1023.0f;
  return saturate(data + noise * quantization_step);
}

float4 gbuffer_closure_data_dither_flush_to_zero(float4 data, float3 noise)
{
  return float4(gbuffer_closure_data_dither_flush_to_zero(data.rgb, noise), data.a);
}

float3 gbuffer_closure_dither_noise(float2 texel, uint layer_id, float3 offset)
{
  float seed = float(layer_id) * 3.0f;
  return interleaved_gradient_noise(texel, float3(seed, seed + 1.0f, seed + 2.0f), offset);
}

float4 gbuffer_closure_data_layer_dither_round_to_nearest(float4 data,
                                                  float2 texel,
                                                  uint layer_id,
                                                  float3 offset)
{
  return gbuffer_closure_data_dither_round_to_nearest(data, gbuffer_closure_dither_noise(texel, layer_id, offset));
}

float4 gbuffer_closure_data_layer_dither_flush_to_zero(float4 data,
                                               float2 texel,
                                               uint layer_id,
                                               float3 offset)
{
  return gbuffer_closure_data_dither_flush_to_zero(data, gbuffer_closure_dither_noise(texel, layer_id, offset));
}
