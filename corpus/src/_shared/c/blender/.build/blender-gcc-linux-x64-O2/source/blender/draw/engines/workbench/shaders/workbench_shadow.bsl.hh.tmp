  workbench_shadow_VertOut _vertex_main(workbench_shadow_Resources  this_, workbench_shadow_VertIn vert_in)
  {
    workbench_shadow_VertOut vert_out;
    vert_out.lP = vert_in.lP;
    float3 L = srt_access(workbench_shadow_Resources, pass_data).light_direction_ws;

    float3 ws_P = drw_point_object_to_world(vert_in.lP);
    float extrude_distance = 1e5f;
    float L_FP = dot(L, srt_access(workbench_shadow_Resources, pass_data).far_plane.xyz);
    if (L_FP > 0.0f) {
      float signed_distance = dot(srt_access(workbench_shadow_Resources, pass_data).far_plane.xyz, ws_P) -
                              srt_access(workbench_shadow_Resources, pass_data).far_plane.w;
      extrude_distance = -signed_distance / L_FP;

      extrude_distance -= 1e-3f;
    }
    vert_out.backPosition = drw_point_world_to_homogenous(ws_P + L * extrude_distance);
    vert_out.frontPosition = drw_point_world_to_homogenous(drw_point_object_to_world(vert_in.lP));
    return vert_out;
  }
#endif
