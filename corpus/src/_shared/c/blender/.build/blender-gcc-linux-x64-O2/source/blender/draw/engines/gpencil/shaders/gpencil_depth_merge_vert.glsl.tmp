VERTEX_SHADER_CREATE_INFO(gpencil_depth_merge)
#line 11
void main()
{
  int v = gl_VertexID % 3;
  float x = -1.0f + float((v & 1) << 2);
  float y = -1.0f + float((v & 2) << 1);
  gl_Position = drw_view().winmat *
                (drw_view().viewmat * (gp_model_matrix * float4(x, y, 0.0f, 1.0f)));
}
