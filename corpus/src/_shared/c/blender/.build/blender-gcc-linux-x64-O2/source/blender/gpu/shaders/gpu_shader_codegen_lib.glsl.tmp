bool closure_has_transmission(const ClosureType closure)
{
  return closure == CLOSURE_BSDF_TRANSLUCENT_ID ||
         closure == CLOSURE_BSDF_MICROFACET_GGX_REFRACTION_ID ||
         closure == CLOSURE_BSDF_THIN_GLASS_TRANSMISSION_ID;
}

