  ClosureUndetermined _read_layer(
      gbuffer_Reader  this_, uchar normal_id, uchar closure_len, GBufferMode bin_mode, int2 texel, uchar layer_id)
  {
    if (bin_mode == GBUF_NONE) {
      return closure_new(ClosureType(CLOSURE_NONE_ID));
    }

    gbuffer_ClosurePacking cl_in;
    cl_in.mode = bin_mode;

    float2 packed_N = _fetch_normal(this_, texel, normal_id).xy;
    cl_in.N = gbuffer_normal_unpack(packed_N);

    cl_in.data0 = _fetch_data(this_, texel, layer_id);
    if (_use_data1(cl_in)) {
      cl_in.data1 = _fetch_data(this_, texel, layer_id + closure_len);
    }
    return gbuffer_detail_unpack_closure(cl_in);
  }
#endif

