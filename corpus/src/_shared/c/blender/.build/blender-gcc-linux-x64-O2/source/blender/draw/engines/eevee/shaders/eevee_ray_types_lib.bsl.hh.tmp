         ScreenSpaceRay ScreenSpaceRay_create(Ray ray, float4x4 winmat, float2 pixel_size)
  {
    float4 start = winmat * float4(ray.origin, 1.0f);
    float4 end = winmat * float4(ray.origin + ray.direction * ray.max_time, 1.0f);

    return ScreenSpaceRay_from_start_end(start, end, pixel_size);
  }
