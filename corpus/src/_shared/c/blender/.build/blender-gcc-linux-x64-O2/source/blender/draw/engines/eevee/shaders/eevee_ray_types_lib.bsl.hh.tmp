         ScreenSpaceRay ScreenSpaceRay_create(ViewMatrices view, Ray ray, float2 pixel_size)
  {
    float4 start = _point_view_to_homogenous(view, ray.origin);
    float4 end = _point_view_to_homogenous(view, ray.origin + ray.direction * ray.max_time);

    return ScreenSpaceRay_from_start_end(start, end, pixel_size);
  }
