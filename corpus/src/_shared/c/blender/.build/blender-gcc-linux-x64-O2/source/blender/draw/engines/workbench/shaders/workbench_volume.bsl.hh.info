#pragma once


#define P(x) ((x + 0.5f) * (1.0f / 16.0f))


GPU_SHADER_CREATE_INFO(workbench_volume_VertIn)
VERTEX_IN(0, float3, pos)
GPU_SHADER_CREATE_END()


GPU_SHADER_CREATE_INFO(workbench_volume_FragOut)
FRAGMENT_OUT(0, float4, workbench_volume_FragOut_color)
GPU_SHADER_CREATE_END()


GPU_SHADER_INTERFACE_INFO(workbench_volume_VertOut_t)
SMOOTH(float3, workbench_volume_VertOut_local_pos)
GPU_SHADER_INTERFACE_END()


GPU_SHADER_CREATE_INFO(workbench_volume_Smoke)
ADDITIONAL_INFO(draw_modelmat)
.sampler(2, ImageType::sampler3D, "flame_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(3, ImageType::sampler1D, "flame_color_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_volume_Volume)
ADDITIONAL_INFO(draw_volume)
PUSH_CONSTANT(float4x4, volume_texture_to_object)
PUSH_CONSTANT(float4x4, volume_object_to_texture)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_volume_ColorBand)
.sampler(4, ImageType::usampler3D, "flag_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(5, ImageType::sampler1D, "transfer_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
PUSH_CONSTANT(bool, show_phi)
PUSH_CONSTANT(bool, show_flags)
PUSH_CONSTANT(bool, show_pressure)
PUSH_CONSTANT(float, grid_scale)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_volume_ColorUniform)
.sampler(4, ImageType::sampler3D, "shadow_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
PUSH_CONSTANT(float3, active_color)
PUSH_CONSTANT(bool, show_flags)
PUSH_CONSTANT(bool, show_pressure)
PUSH_CONSTANT(float, grid_scale)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_volume_Resources)
ADDITIONAL_INFO(draw_view)
ADDITIONAL_INFO(draw_object_infos)
ADDITIONAL_INFO(draw_resource_id_varying)
.noop()

.noop()

.noop()

.noop()

.sampler(0, ImageType::sampler2DDepth, "depth_buffer", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(1, ImageType::sampler3D, "density_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(7, ImageType::usampler2D, "stencil_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
PUSH_CONSTANT(int, samples_len)
PUSH_CONSTANT(float, noise_ofs)
PUSH_CONSTANT(float, step_length)
PUSH_CONSTANT(float, density_fac)
PUSH_CONSTANT(bool, do_depth_test)
PUSH_CONSTANT(int, slice_axis)
PUSH_CONSTANT(float, slice_position)
.additional_info_with_condition("workbench_volume_Volume", [](blender::Span<CompilationConstant> constants) { int is_legacy_smoke = ShaderCreateInfo::find_constant(constants, "is_legacy_smoke"); return (!is_legacy_smoke);})
.additional_info_with_condition("workbench_volume_Smoke", [](blender::Span<CompilationConstant> constants) { int is_legacy_smoke = ShaderCreateInfo::find_constant(constants, "is_legacy_smoke"); return (is_legacy_smoke);})
.additional_info_with_condition("workbench_volume_ColorBand", [](blender::Span<CompilationConstant> constants) { int use_color_band = ShaderCreateInfo::find_constant(constants, "use_color_band"); return (use_color_band);})
.additional_info_with_condition("workbench_volume_ColorUniform", [](blender::Span<CompilationConstant> constants) { int use_color_band = ShaderCreateInfo::find_constant(constants, "use_color_band"); return (!use_color_band);})
GPU_SHADER_CREATE_END()

GPU_SHADER_CREATE_INFO(workbench_volume_vertex_function_infos_)
ADDITIONAL_INFO(workbench_volume_Resources)
ADDITIONAL_INFO(workbench_volume_VertIn)
VERTEX_OUT(workbench_volume_VertOut_t)
GPU_SHADER_CREATE_END()

