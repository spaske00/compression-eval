float4 workbench_wrapped_lighting(float4 NL, float4 w)
{
  float4 w_1 = w + 1.0f;
  float4 denom = workbench_fast_rcp(w_1 * w_1);
  return clamp((NL + w) * denom, 0.0f, 1.0f);
}
