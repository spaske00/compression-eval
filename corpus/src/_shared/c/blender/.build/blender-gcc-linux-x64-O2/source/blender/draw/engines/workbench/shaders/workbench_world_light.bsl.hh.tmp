float4 workbench_blinn_specular(float4 shininess, float4 spec_angle, float4 NL)
{
#line 34
  float4 normalization_factor = shininess * 0.125f + 1.0f;
  float4 spec_light = pow(spec_angle, shininess) * NL * normalization_factor;

