    srt_access(eevee_velocity_VertexCopy, out_buf)[vert_start + vertex_id] = float4(
        srt_access(eevee_velocity_VertexCopy, in_buf)[vertex_id * vert_stride + 0],
        srt_access(eevee_velocity_VertexCopy, in_buf)[vertex_id * vert_stride + 1],
        srt_access(eevee_velocity_VertexCopy, in_buf)[vertex_id * vert_stride + 2],
        1.0f                                                                           );
  }

