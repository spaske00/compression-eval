  float4 _resolve(eevee_CameraVelocity  this_, const draw_View  views,
                 float4 vector,
                 float2 uv,
                 float depth)
  {
    const ViewMatrices view = _get(views, 0);
    if (vector.x == VELOCITY_INVALID) {
      bool is_background = (depth == 1.0f);
      if (is_background) {

        float3 vV = -_view_incident_vector(view, _point_screen_to_view(view, float3(uv, 1.0f)));
        return _background_velocity(this_, vV);
      }

      float3 P = _point_screen_to_world(view, float3(uv, depth));
      return _surface_velocity(this_, P, P, P);
    }
    return eevee_velocity_unpack(vector);
  }
#endif
