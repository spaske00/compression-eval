  float4 _resolve(eevee_CameraVelocity  this_, const draw_View  views,
                 sampler2D vector_tx,
                 int2 texel,
                 float depth)
  {
    float2 uv = (float2(texel) + 0.5f) / float2(textureSize(vector_tx, 0).xy);
    float4 vector = texelFetch(vector_tx, texel, 0);
    return _resolve(this_, views, vector, uv, depth);
  }
