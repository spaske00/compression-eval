  float3 _spherical_sample_normalized_with_parallax(eevee_LightprobeSphereRenderData  this_, eevee_LightProbeSample samp,
                                                   float3 P,
                                                   float3 L,
                                                   float lod)
  {
    SphereProbeData probe = lightprobe_sphere_buf[samp.spherical_id];
    ReflectionProbeLowFreqLight shading_sh = eevee_lightprobe_sphere_extract_low_freq_lighting(
        samp.volume_irradiance);
    float normalization_fac = eevee_lightprobe_sphere_normalization_factor(
        L, shading_sh, probe.low_freq_light);
    L = eevee_lightprobe_sphere_parallax_eval(probe, P, L);
    return normalization_fac * _sample_probe(this_, L, lod, probe.atlas_coord).rgb;
  }
