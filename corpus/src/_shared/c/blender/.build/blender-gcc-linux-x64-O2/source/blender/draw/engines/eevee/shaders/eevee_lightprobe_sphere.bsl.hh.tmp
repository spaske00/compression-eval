  float4 _sample_probe(eevee_LightprobeSphereRenderData  this_, float3 L, float lod, SphereProbeUvArea uv_area)
  {
    float lod_min = floor(lod);
    float lod_max = ceil(lod);
    float mix_fac = lod - lod_min;

    float2 altas_uv_min, altas_uv_max;
    eevee_lightprobe_sphere_direction_to_uv(L, lod_min, lod_max, uv_area, altas_uv_min, altas_uv_max);

    float4 color_min = textureLod(
        srt_access(eevee_LightprobeSphereRenderData, lightprobe_spheres_tx), float3(altas_uv_min, uv_area.layer), lod_min);
    float4 color_max = textureLod(
        srt_access(eevee_LightprobeSphereRenderData, lightprobe_spheres_tx), float3(altas_uv_max, uv_area.layer), lod_max);
    return mix(color_min, color_max, mix_fac);
  }
#endif
