void node_attribute(float4 attr, _ref(float4 ,outcol), _ref(float3 ,outvec), _ref(float ,outf), _ref(float ,outalpha))
{
  outcol = float4(attr.xyz, 1.0f);
  outvec = attr.xyz;
  outf = math_average(attr.xyz);
  outalpha = attr.w;
}
