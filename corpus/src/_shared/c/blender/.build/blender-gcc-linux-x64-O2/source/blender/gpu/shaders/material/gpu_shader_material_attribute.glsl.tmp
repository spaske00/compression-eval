void node_attribute_temperature(float4 attr, _ref(float4 ,out_attr))
{
  float temperature = attr_load_temperature_post(attr.x);
  out_attr.x = temperature;
  out_attr.y = temperature;
  out_attr.z = temperature;
  out_attr.w = 1.0f;
}
