  float3 _debug_tile_state_color(eevee_ShadowDebug  this_, ShadowTileData tile)
  {
    if (tile.do_update && tile.is_used) {

      return float3(0.5f, 1, 0);
    }
    if (tile.is_used) {

      return float3(0, 1, 0);
    }
    float3 col = float3(0);
    if (tile.is_cached) {
      col += float3(0.2f, 0, 0.5f);
      if (tile.do_update) {
        col += float3(0.8f, 0, 0);
      }
    }
    return col;
  }
#endif

