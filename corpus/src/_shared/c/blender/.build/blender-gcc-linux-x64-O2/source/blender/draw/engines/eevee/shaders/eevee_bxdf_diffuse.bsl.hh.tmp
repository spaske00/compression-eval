BsdfSample bxdf_translucent_sample(float3 rand, Thickness thickness)
{
  if (_mode(thickness) == ThicknessMode_Sphere) {

    float cos_theta = rand.x * 2.0f - 1.0f;
    BsdfSample samp;
    samp.direction = float3(rand.yz * sin_from_cos(cos_theta), -cos_theta);
    samp.pdf = 0.25f * M_1_PI;
    return samp;
  }
#line 91
  BsdfSample samp = bxdf_diffuse_sample(rand);
  samp.direction = -samp.direction;
  return samp;
}

BsdfEval bxdf_translucent_eval(float3 N, float3 L, Thickness thickness)
{
  if (_mode(thickness) == ThicknessMode_Sphere) {

    BsdfEval eval;
    eval.throughput = eval.pdf = 0.25f * M_1_PI;
    return eval;
  }

  BsdfEval eval;
  eval.throughput = eval.pdf = saturate(dot(-N, L));
  return eval;
}

float bxdf_translucent_perceived_roughness()
{
  return 1.0f;
}

LightProbeRay bxdf_translucent_lightprobe(float3 N, Thickness thickness)
{
  LightProbeRay probe;
  probe.perceptual_roughness = bxdf_translucent_perceived_roughness();

  probe.dominant_direction = (_mode(thickness) == ThicknessMode_Sphere) ? float3(0.0f) : -N;
  return probe;
}

Ray bxdf_translucent_ray_amend(ClosureUndetermined cl, float3 _0, Ray ray, Thickness thickness)
{
  if (_mode(thickness) == ThicknessMode_Sphere) {
#line 129
    ray.origin += (ray.direction - cl.N) * _value(thickness) * 0.505f;
