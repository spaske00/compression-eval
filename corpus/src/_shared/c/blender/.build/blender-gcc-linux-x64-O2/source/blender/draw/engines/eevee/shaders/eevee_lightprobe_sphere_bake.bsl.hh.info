#pragma once






GPU_SHADER_CREATE_INFO(eevee_lightprobe_sphere_Remap)
SPECIALIZATION_CONSTANT(bool, extract_sh, true)
SPECIALIZATION_CONSTANT(bool, extract_sun, true)
PUSH_CONSTANT(bool, do_remap_mip0)
PUSH_CONSTANT(int4, probe_coord_packed)
PUSH_CONSTANT(int4, write_coord_packed)
PUSH_CONSTANT(int4, world_coord_packed)
.sampler(0, ImageType::samplerCube, "cubemap_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(1, ImageType::sampler2DArray, "atlas_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.image(0, blender::gpu::TextureFormat::SPHERE_PROBE_FORMAT, Qualifier::write, ImageReadWriteType::image2DArray, "atlas_img", Frequency::PASS)
GROUP_SHARED(float4, local_radiance[SPHERE_PROBE_REMAP_GROUP_SIZE * SPHERE_PROBE_REMAP_GROUP_SIZE])
.storage_buf(0, Qualifier::write, "SphereProbeHarmonic", "out_sh[]", Frequency::PASS)
.storage_buf(1, Qualifier::write, "SphereProbeSunLight", "out_sun[]", Frequency::PASS)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(eevee_lightprobe_sphere_Convolve)
PUSH_CONSTANT(int4, probe_coord_packed)
PUSH_CONSTANT(int4, write_coord_packed)
PUSH_CONSTANT(int4, read_coord_packed)
PUSH_CONSTANT(int, read_lod)
.sampler(0, ImageType::samplerCube, "cubemap_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(1, ImageType::sampler2DArray, "in_atlas_mip_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.image(1, blender::gpu::TextureFormat::SFLOAT_16_16_16_16, Qualifier::write, ImageReadWriteType::image2DArray, "out_atlas_mip_img", Frequency::PASS)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(eevee_lightprobe_sphere_IrradianceSum)
PUSH_CONSTANT(int3, probe_remap_dispatch_size)
GROUP_SHARED(float4, local_sh_coefs[SPHERE_PROBE_SH_GROUP_SIZE][4])
.storage_buf(1, Qualifier::write, "SphereProbeHarmonic", "out_sh", Frequency::PASS)
.storage_buf(0, Qualifier::read, "SphereProbeHarmonic", "in_sh[]", Frequency::PASS)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(eevee_lightprobe_sphere_SunExtraction)
PUSH_CONSTANT(int, sun_id)
PUSH_CONSTANT(int3, probe_remap_dispatch_size)
GROUP_SHARED(float3, local_radiance[SPHERE_PROBE_SH_GROUP_SIZE])
GROUP_SHARED(float4, local_direction[SPHERE_PROBE_SH_GROUP_SIZE])
.storage_buf(0, Qualifier::read, "SphereProbeSunLight", "in_sun[]", Frequency::PASS)
.storage_buf(1, Qualifier::write, "LightData", "sunlight_buf[2]", Frequency::PASS)
GPU_SHADER_CREATE_END()

