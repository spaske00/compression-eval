.image(0, blender::gpu::TextureFormat::SFLOAT_32, Qualifier::write, ImageReadWriteType::image2D, "out_mip_0", Frequency::PASS)
.image(1, blender::gpu::TextureFormat::SFLOAT_32, Qualifier::write, ImageReadWriteType::image2D, "out_mip_1", Frequency::PASS)
