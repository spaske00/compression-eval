.image(4, blender::gpu::TextureFormat::SFLOAT_32, Qualifier::write, ImageReadWriteType::image2D, "out_mip_4", Frequency::PASS)
.image(5, blender::gpu::TextureFormat::SFLOAT_32, Qualifier::read_write, ImageReadWriteType::image2D, "out_mip_5", Frequency::PASS)
.image(6, blender::gpu::TextureFormat::SFLOAT_32, Qualifier::write, ImageReadWriteType::image2D, "out_mip_6", Frequency::PASS)
GROUP_SHARED(float, local_depths[HIZ_GROUP_SIZE][HIZ_GROUP_SIZE])
.storage_buf(0, Qualifier::read_write, "uint", "finished_tile_counter", Frequency::PASS)
