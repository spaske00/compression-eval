.sampler(0, ImageType::sampler2DDepth, "depth_tx", Frequency::PASS, GPUSamplerState::internal_sampler(), [](blender::Span<CompilationConstant> constants) { int use_layer = ShaderCreateInfo::find_constant(constants, "use_layer"); return (!use_layer);})
.sampler(0, ImageType::sampler2DArrayDepth, "depth_layered_tx", Frequency::PASS, GPUSamplerState::internal_sampler(), [](blender::Span<CompilationConstant> constants) { int use_layer = ShaderCreateInfo::find_constant(constants, "use_layer"); return (use_layer);})
