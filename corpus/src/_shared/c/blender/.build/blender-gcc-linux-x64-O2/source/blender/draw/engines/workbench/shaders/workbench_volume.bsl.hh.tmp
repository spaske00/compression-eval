}

float4 workbench_volume_flag_to_color(uint flag)
{

  float4 color = float4(0.0f, 0.0f, 0.0f, 0.06f);

  if (bool(flag & uint(1))) {
    color.rgb += float3(0.0f, 0.0f, 0.75f);
  }
  if (bool(flag & uint(2))) {
    color.rgb += float3(0.2f, 0.2f, 0.2f);
  }
  if (bool(flag & uint(4))) {
    color.rgb += float3(0.25f, 0.0f, 0.2f);
  }
  if (bool(flag & uint(8))) {
    color.rgb += float3(0.0f, 0.5f, 0.0f);
  }
  if (bool(flag & uint(16))) {
    color.rgb += float3(0.9f, 0.3f, 0.0f);
  }
  if (is_zero(color.rgb)) {
    color.rgb += float3(0.5f, 0.0f, 0.0f);
  }
  return color;
}
