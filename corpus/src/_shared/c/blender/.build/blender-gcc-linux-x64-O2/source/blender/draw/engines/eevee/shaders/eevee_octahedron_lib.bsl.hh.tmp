float2 octahedral_uv_from_direction(float3 co)
{

  co /= dot(float3(1.0f), abs(co));
#line 18
  if (co.z < 0.0f) {
    float2 sign = step(0.0f, co.xy) * 2.0f - 1.0f;
    co.xy = (1.0f - abs(co.yx)) * sign;
