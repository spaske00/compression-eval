  float4 _sample_bsdf_lut(UtilityTexture  this_, float2 uv, float layer)
  {

    uv = uv * UTIL_TEX_UV_SCALE + UTIL_TEX_UV_BIAS;
    layer = layer * UTIL_BSDF_LAYER_COUNT + UTIL_BSDF_LAYER;

    float layer_floored;
    float interp = modf(layer, layer_floored);

    float4 tex_low = textureLod(srt_access(UtilityTexture, utility_tx), float3(uv, layer_floored), 0.0f);
    float4 tex_high = textureLod(srt_access(UtilityTexture, utility_tx), float3(uv, layer_floored + 1.0f), 0.0f);
#line 47
    return mix(tex_low, tex_high, interp);
  }
#endif
