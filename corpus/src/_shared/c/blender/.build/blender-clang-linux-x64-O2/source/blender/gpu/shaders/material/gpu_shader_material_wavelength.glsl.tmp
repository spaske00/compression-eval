#line 1 "gpu_shader_material_wavelength.glsl"
 
#line 6
void node_wavelength(float wavelength, sampler1DArray spectrummap, float layer, _ref(float4 ,color))
{
  float t = (wavelength - 380.0f) / (780.0f - 380.0f);
  float3 rgb = texture(spectrummap, float2(t, layer)).rgb;
  rgb *= 1.0f / 2.52f;
  color = float4(clamp(rgb, 0.0f, 1.0f), 1.0f);
}
