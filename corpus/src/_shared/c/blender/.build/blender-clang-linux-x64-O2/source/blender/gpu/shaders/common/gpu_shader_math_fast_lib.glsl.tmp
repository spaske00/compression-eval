float2 acos_fast(float2 v)
{
  float2 res = -0.156583f * abs(v) + M_PI_2;
  res *= sqrt_fast(1.0f - abs(v));
  v.x = (v.x >= 0) ? res.x : M_PI - res.x;
  v.y = (v.y >= 0) ? res.y : M_PI - res.y;
  return v;
}

