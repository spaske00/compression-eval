MotionPayload motion_blur_tile_indirection_pack_payload(float2 motion, uint2 payload)
{
#line 18
  uint velocity = min(uint(ceil(length(motion))), 0x3FFFu);

  return (velocity << 18u) | ((payload.x & 0x1FFu) << 9u) | (payload.y & 0x1FFu);
