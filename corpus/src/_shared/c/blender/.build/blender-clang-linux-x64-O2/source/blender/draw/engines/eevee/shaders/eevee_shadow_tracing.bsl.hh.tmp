bool eevee_shadow_map_trace(eevee_ShadowRenderData  srd,
                      eevee_ShadowRayDirectional ray,
                      int sample_count,
                      float step_offset)
{
  eevee_ShadowMapTracingState state = eevee_shadow_map_trace_init(sample_count, step_offset);
  for (int i = 0; (i <= sample_count) && (i <= SHADOW_MAX_STEP) && (state.hit == false); i++)
  {
    state.ray_time = square(saturate(float(i) * state.ray_step_mul + state.ray_step_bias));

    eevee_ShadowTracingSample samp = eevee_shadow_map_trace_sample(srd, state, ray);

    eevee_shadow_map_trace_hit_check(state, samp, i == sample_count);
  }
  return state.hit;
}
