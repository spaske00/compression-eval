void vector_math_project(
    float3 a, float3 b, float3 c, float scale, _ref(float3 ,outVector), _ref(float ,outValue))
{
  float lenSquared = dot(b, b);
  outVector = (lenSquared != 0.0f) ? (dot(a, b) / lenSquared) * b : float3(0.0f);
}
