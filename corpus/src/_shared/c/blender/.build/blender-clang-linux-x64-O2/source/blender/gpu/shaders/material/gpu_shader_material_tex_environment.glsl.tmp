#line 1 "gpu_shader_material_tex_environment.glsl"
 
#line 9
void node_tex_environment_equirectangular(float3 co, _ref(float3 ,uv))
{
  float3 nco = vector_math_safe_normalize(co);
  if (nco.x == 0.0f || nco.y == 0.0f) {
    uv = float3(0.0f);
    return;
  }
  uv.x = -atan(nco.y, nco.x) / (2.0f * M_PI) + 0.5f;
  uv.y = atan(nco.z, hypot(nco.x, nco.y)) / M_PI + 0.5f;
}
#line 21
void node_tex_environment_mirror_ball(float3 co, _ref(float3 ,uv))
{
  float3 nco = vector_math_safe_normalize(co);
  nco.y -= 1.0f;

  float div = 2.0f * sqrt(max(-0.5f * nco.y, 0.0f));
  nco /= max(1e-8f, div);

  uv = 0.5f * nco.xzz + 0.5f;
}
#line 33
void node_tex_environment_empty(float3 co, _ref(float4 ,color))
{
  color = float4(1.0f, 0.0f, 1.0f, 1.0f);
}
