#pragma once


#define WORKBENCH_LIGHTING_STUDIO 0
#define WORKBENCH_LIGHTING_MATCAP 1
#define WORKBENCH_LIGHTING_FLAT 2

                                                                           

GPU_SHADER_CREATE_INFO(workbench_prepass_MeshIn)
VERTEX_IN(0, float3, pos)
VERTEX_IN(1, float3, nor)
VERTEX_IN(2, float4, ac)
VERTEX_IN(3, float2, au)
GPU_SHADER_CREATE_END()


GPU_SHADER_CREATE_INFO(workbench_prepass_OpaqueOut)
FRAGMENT_OUT(0, float4, workbench_prepass_OpaqueOut_material)
FRAGMENT_OUT(1, float2, workbench_prepass_OpaqueOut_normal)
FRAGMENT_OUT(2, uint, workbench_prepass_OpaqueOut_object_id)
GPU_SHADER_CREATE_END()

GPU_SHADER_CREATE_INFO(workbench_prepass_TransparentOut)
FRAGMENT_OUT(0, float4, workbench_prepass_TransparentOut_transparent_accum)
FRAGMENT_OUT(1, float4, workbench_prepass_TransparentOut_revealage_accum)
FRAGMENT_OUT(2, uint, workbench_prepass_TransparentOut_object_id)
GPU_SHADER_CREATE_END()


GPU_SHADER_INTERFACE_INFO(workbench_prepass_VertOut_t)
SMOOTH(float3, workbench_prepass_VertOut_normal)
SMOOTH(float3, workbench_prepass_VertOut_color)
SMOOTH(float2, workbench_prepass_VertOut_uv)
SMOOTH(float, workbench_prepass_VertOut_alpha)
FLAT(int, workbench_prepass_VertOut_object_id)
FLAT(float, workbench_prepass_VertOut_roughness)
FLAT(float, workbench_prepass_VertOut_metallic)
GPU_SHADER_INTERFACE_END()


GPU_SHADER_CREATE_INFO(workbench_prepass_Mesh)
ADDITIONAL_INFO(drw_clipped)
.noop()

GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_prepass_Curves)
ADDITIONAL_INFO(draw_curves)
ADDITIONAL_INFO(draw_curves_infos)
ADDITIONAL_INFO(drw_clipped)
.noop()

.sampler(WB_CURVES_COLOR_SLOT, ImageType::samplerBuffer, "ac", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(WB_CURVES_UV_SLOT, ImageType::samplerBuffer, "au", Frequency::PASS, GPUSamplerState::internal_sampler())
PUSH_CONSTANT(int, emitter_object_id)
GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_prepass_PointCloud)
ADDITIONAL_INFO(draw_pointcloud)
ADDITIONAL_INFO(drw_clipped)
.noop()

GPU_SHADER_CREATE_END()
GPU_SHADER_CREATE_INFO(workbench_prepass_Resources)
.noop()

.noop()

PUSH_CONSTANT(bool, force_shadowing)
.additional_info_with_condition("workbench_color_Texture", [](blender::Span<CompilationConstant> constants) { int use_texture = ShaderCreateInfo::find_constant(constants, "use_texture"); return (use_texture);})
.sampler(WB_MATCAP_SLOT, ImageType::sampler2DArray, "matcap_tx", Frequency::PASS, GPUSamplerState::internal_sampler(), [](blender::Span<CompilationConstant> constants) { int lighting_mode = ShaderCreateInfo::find_constant(constants, "lighting_mode"); return (lighting_mode == 1                                );})
GPU_SHADER_CREATE_END()

GPU_SHADER_CREATE_INFO(workbench_prepass_vert_mesh_infos_)
BUILTINS(BuiltinBits::INSTANCE_ID)
ADDITIONAL_INFO(workbench_prepass_Mesh)
ADDITIONAL_INFO(workbench_color_Materials)
ADDITIONAL_INFO(draw_View)
ADDITIONAL_INFO(draw_Model)
ADDITIONAL_INFO(draw_ResourceCustomID)
ADDITIONAL_INFO(workbench_prepass_MeshIn)
VERTEX_OUT(workbench_prepass_VertOut_t)
GPU_SHADER_CREATE_END()

GPU_SHADER_CREATE_INFO(workbench_prepass_vert_curves_infos_)
BUILTINS(BuiltinBits::INSTANCE_ID)
BUILTINS(BuiltinBits::VERTEX_ID)
ADDITIONAL_INFO(workbench_prepass_Curves)
