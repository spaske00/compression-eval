uint2 get_pixel_coord(sampler2D tex, float2 uv)
{
  float2 size = float2(textureSize(tex, 0));
  return uint2(uv * size);
}

float4 apply_dither(float4 col, uint2 uv)
{
  col.rgb += dither_random_value(uv) * 0.0033 * parameters.dither;
  return col;
}
