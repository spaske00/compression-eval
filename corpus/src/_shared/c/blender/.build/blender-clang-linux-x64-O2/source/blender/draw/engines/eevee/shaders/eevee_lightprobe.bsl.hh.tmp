  eevee_LightProbeSample _load(eevee_LightprobeRenderData  this_, float2 screen_texel, float3 P, float3 Ng, float3 V)
  {
    const eevee_Sampling samp = srt_access(eevee_LightprobeRenderData, sampling);
#line 33
    float noise = interleaved_gradient_noise(screen_texel, 0.0f, 0.0f);
    noise = fract(noise + _rng_1D_get(samp, SAMPLING_LIGHTPROBE));

    eevee_LightProbeSample result;
    result.volume_irradiance = _sample_probe(srt_access(eevee_LightprobeRenderData, volumes), samp, P, V, Ng);
    result.spherical_id = _select_probe(srt_access(eevee_LightprobeRenderData, spheres), P, noise);
    return result;
  }
#endif

