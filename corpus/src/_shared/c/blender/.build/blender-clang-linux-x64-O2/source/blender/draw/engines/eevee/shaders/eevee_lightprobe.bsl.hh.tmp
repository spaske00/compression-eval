  float3 _eval(eevee_LightprobeRenderData  this_, const UtilityTexture  util_tx,
              eevee_LightProbeSample samp,
              ClosureSubsurface cl,
              float3 _0,
              float3 _1,
              Thickness thickness)
  {
    float3 sss_profile = subsurface_transmission(util_tx, cl.sss_radius, _value(thickness));
    float3 radiance_sh = _evaluate_lambert(samp.volume_irradiance, cl.N).rgb;
    radiance_sh += _evaluate_lambert(samp.volume_irradiance, -cl.N).rgb * sss_profile;
    return radiance_sh;
  }
#endif

#if defined(CREATE_INFO_eevee_LightprobeRenderData)
