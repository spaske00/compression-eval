  float3 _eval(
      eevee_LightprobeRenderData  this_, eevee_LightProbeSample samp, ClosureUndetermined cl, float3 P, float3 V, Thickness thickness)
  {
#line 75
    LightProbeRay ray = bxdf_lightprobe_ray(cl, P, V, thickness);

    float lod = eevee_lightprobe_sphere_roughness_to_lod(ray.perceptual_roughness);
    float fac = eevee_lightprobe_sphere_roughness_to_mix_fac(ray.perceptual_roughness);

    float3 radiance_cube = _spherical_sample_normalized_with_parallax(srt_access(eevee_LightprobeRenderData, spheres), samp, P, ray.dominant_direction, lod);
    float3 radiance_sh = _evaluate_lambert(samp.volume_irradiance, ray.dominant_direction).rgb;
    return mix(radiance_cube, radiance_sh, fac);
  }
#endif
