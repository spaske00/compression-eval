Thickness gbuffer_thickness_unpack(float thickness_packed)
{

  float thickness = (thickness_packed > 0.5f) ? 1.0f - thickness_packed : thickness_packed;

  thickness = thickness / (1.0f - 2.0f * thickness);

  return (thickness_packed > 0.5f) ? Thickness_from(thickness, ThicknessMode_Slab) :
