float3 workbench_prepass_hair_random_normal(float3 tangent, float3 binor, float3 nor, float rand)
{

  nor = normalize(mix(nor, -tangent, rand * 0.1f));
  float cos_theta = (rand * 2.0f - 1.0f) * 0.2f;
  float sin_theta = sin_from_cos(cos_theta);
  nor = nor * sin_theta + binor * cos_theta;
  return nor;
}

void workbench_prepass_hair_random_material(float rand, _ref(float3 ,color), _ref(float ,roughness), _ref(float ,metallic))
{

  rand -= 0.5f;
  rand *= 0.1f;

  metallic = saturate(metallic + rand);
  roughness = saturate(roughness + rand);

  color = saturate(color + rand * (color + 0.05f));
}

