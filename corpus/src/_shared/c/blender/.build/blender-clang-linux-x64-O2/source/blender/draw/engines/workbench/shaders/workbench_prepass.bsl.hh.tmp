float workbench_prepass_linear_zdepth(float depth, float4x4 proj_mat)
{
  if (proj_mat[3][3] == 0.0f) {
    float d = 2.0f * depth - 1.0f;
    return -proj_mat[3][2] / (d + proj_mat[2][2]);
  }

  float z_delta = -2.0f / proj_mat[2][2];
  return depth * z_delta;
}
