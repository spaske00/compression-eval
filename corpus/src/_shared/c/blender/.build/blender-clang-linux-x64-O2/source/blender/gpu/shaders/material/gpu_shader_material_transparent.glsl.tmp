#line 1 "gpu_shader_material_transparent.glsl"
 
#line 6
void node_bsdf_transparent(float4 color, float weight, _ref(Closure ,result))
{
  color = max(color, float4(0.0f));

  ClosureTransparency transparency_data;
  transparency_data.weight = weight;
  transparency_data.transmittance = color.rgb;
  transparency_data.holdout = 0.0f;

  result = closure_eval(transparency_data);
}
