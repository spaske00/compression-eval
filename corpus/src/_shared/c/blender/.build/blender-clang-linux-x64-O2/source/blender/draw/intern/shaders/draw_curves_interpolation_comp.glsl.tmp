#line 225
float4 catmull_rom_calculate_basis(const float parameter)
{

  const float t = parameter;
  const float s = 1.0f - parameter;
  return 0.5f * float4(-t * s * s,
                       2.0f + t * t * (3.0f * t - 5.0f),
                       2.0f + s * s * (3.0f * s - 5.0f),
                       -s * t * t);
}

int4 catmull_rom_get_points(uint point_id, IndexRange points, const bool cyclic)
{
  int4 point_ids = int(point_id) + int4(-1, +0, +1, +2);
  if (cyclic) {

    point_ids = ((point_ids + _size(points)) % _size(points));
  }
  else {
    point_ids = clamp(point_ids, int4(0), int4(_size(points) - 1));
  }
  return _start(points) + point_ids;
}
