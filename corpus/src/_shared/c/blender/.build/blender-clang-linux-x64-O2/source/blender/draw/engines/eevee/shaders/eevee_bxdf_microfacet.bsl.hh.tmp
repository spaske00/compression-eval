ClosureLight bxdf_ggx_light_reflection(const UtilityTexture  util_tx,
                                       ClosureReflection cl,
                                       float3 V)
{
  float cos_theta = dot(cl.N, V);

  ClosureLight light;
  light.ltc_mat = eevee_lut_ltc_sample_utility_tx(util_tx, cos_theta, cl.roughness);
  light.N = cl.N;
  light.type = LIGHT_SPECULAR;
  return light;
}
