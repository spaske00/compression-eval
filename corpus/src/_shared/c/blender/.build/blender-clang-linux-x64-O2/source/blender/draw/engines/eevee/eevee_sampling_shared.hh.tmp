}
#line 71
              int sampling_web_ring_count_get(int web_density, int sample_count)
{

  float x = 2.0f * (float(sample_count) - 1.0f) / float(web_density);

  float discriminant = 1.0f + 4.0f * x;
  return int(ceilf(0.5f * (sqrtf(discriminant) - 1.0f)));
}




