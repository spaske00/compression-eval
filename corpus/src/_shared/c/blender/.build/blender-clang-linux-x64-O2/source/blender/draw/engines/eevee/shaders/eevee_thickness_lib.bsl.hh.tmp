  ThicknessMode _mode(const Thickness this_)
  {
    return this_.data > 0.0 ? ThicknessMode_Sphere : ThicknessMode_Slab;
  }
#line 48
  ThicknessIsect _shape_intersect(_ref(Thickness ,this_), float3 N, float3 L)
  {
    if (_mode(this_) == ThicknessMode_Sphere) {
      return _sphere_intersect(this_, _value(this_), N, L);
    }
    return _plane_intersect(this_, _value(this_), N, L);
  }
#line 63
  ThicknessIsect _sphere_intersect(_ref(Thickness ,this_), float diameter, float3 N, float3 L)
  {
    ThicknessIsect isect;
    float cos_alpha = dot(L, -N);
    isect.hit_N = normalize(N + L * (cos_alpha * 2.0f));
    isect.hit_P = L * (cos_alpha * diameter);
    return isect;
  }
#line 78
  ThicknessIsect _plane_intersect(_ref(Thickness ,this_), float plane_distance, float3 N, float3 L)
  {
    ThicknessIsect isect;
    float distance_from_shading_plane = dot(L, -N);
    isect.hit_N = -N;
    isect.hit_P = L * (plane_distance / distance_from_shading_plane);
    return isect;
  }
