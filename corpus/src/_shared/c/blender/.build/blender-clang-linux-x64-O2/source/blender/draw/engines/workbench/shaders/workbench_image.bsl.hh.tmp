float3 workbench_color_image_color(workbench_color_Texture  srt, float2 uvs)
{
  float4 color;

  float3 co = float3(uvs, 0.0f);
  if (srt_access(workbench_color_Texture, is_image_tile)) {
    if (workbench_color_tile_lookup(co, srt_access(workbench_color_Texture, imageTileData))) {
      color = texture(srt_access(workbench_color_Texture, imageTileArray), co);
    }
    else {
      color = float4(1.0f, 0.0f, 1.0f, 1.0f);
    }
  }
  else {
    color = texture(srt_access(workbench_color_Texture, imageTexture), uvs);
  }
#line 64
  if (srt_access(workbench_color_Texture, image_premult) && !(color.a == 0.0f || color.a == 1.0f)) {
    color.rgb /= color.a;
  }

  if (color.a < srt_access(workbench_color_Texture, image_transparency_cutoff)) {
    gpu_discard_fragment();
  }

