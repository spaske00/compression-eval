void tex_box_sample_linear(
    float3 texco, float3 N, sampler2D ima, _ref(float4 ,color1), _ref(float4 ,color2), _ref(float4 ,color3))
{

  float2 uv = texco.yz;
  if (N.x < 0.0f) {
    uv.x = 1.0f - uv.x;
  }
  color1 = texture(ima, uv);

  uv = texco.xz;
  if (N.y > 0.0f) {
    uv.x = 1.0f - uv.x;
  }
  color2 = texture(ima, uv);

  uv = texco.yx;
  if (N.z > 0.0f) {
    uv.x = 1.0f - uv.x;
  }
  color3 = texture(ima, uv);
}
#line 106
void tex_box_sample_cubic(
    float3 texco, float3 N, sampler2D ima, _ref(float4 ,color1), _ref(float4 ,color2), _ref(float4 ,color3))
{
  float alpha;

  float2 uv = texco.yz;
  if (N.x < 0.0f) {
    uv.x = 1.0f - uv.x;
  }
  node_tex_image_cubic(uv.xyy, ima, color1, alpha);

  uv = texco.xz;
  if (N.y > 0.0f) {
    uv.x = 1.0f - uv.x;
  }
  node_tex_image_cubic(uv.xyy, ima, color2, alpha);

  uv = texco.yx;
  if (N.z > 0.0f) {
    uv.x = 1.0f - uv.x;
  }
  node_tex_image_cubic(uv.xyy, ima, color3, alpha);
}
