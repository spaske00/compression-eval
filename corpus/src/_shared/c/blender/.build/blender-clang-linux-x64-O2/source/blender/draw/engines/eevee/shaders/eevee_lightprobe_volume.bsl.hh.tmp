  SphericalHarmonicL1Tfloat4 _sample_atlas(eevee_LightprobeVolumeRenderData  this_, float3 atlas_coord)
  {
    float4 texture_coord = float4(atlas_coord, float(IRRADIANCE_GRID_BRICK_SIZE)) /
                           float3(textureSize(srt_access(eevee_LightprobeVolumeRenderData, irradiance_atlas_tx), 0)).xyzz;
    SphericalHarmonicL1Tfloat4 sh;
    sh.L0.M0 = textureLod(srt_access(eevee_LightprobeVolumeRenderData, irradiance_atlas_tx), texture_coord.xyz, 0.0f);
    texture_coord.z += texture_coord.w;
    sh.L1.Mn1 = textureLod(srt_access(eevee_LightprobeVolumeRenderData, irradiance_atlas_tx), texture_coord.xyz, 0.0f);
    texture_coord.z += texture_coord.w;
    sh.L1.M0 = textureLod(srt_access(eevee_LightprobeVolumeRenderData, irradiance_atlas_tx), texture_coord.xyz, 0.0f);
    texture_coord.z += texture_coord.w;
    sh.L1.Mp1 = textureLod(srt_access(eevee_LightprobeVolumeRenderData, irradiance_atlas_tx), texture_coord.xyz, 0.0f);
    return sh;
  }
#endif

