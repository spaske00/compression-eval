#line 207
float3 orthogonalTfloat3(float3 v)
{
  switch (dominant_axis(v)) {
    default:
    case 0:
      return float3(-v.y - v.z, v.x, v.x);
    case 1:
      return float3(v.y, -v.x - v.z, v.y);
    case 2:
      return float3(v.z, v.z, -v.x - v.y);
  }
}





