  bool _can_merge_sample(eevee_Cryptomatte  this_, float2 dst, float2 src)
  {
    if (all(equal(dst, float2(0.0f, 0.0f)))) {
      return true;
    }
    if (dst.x == src.x) {
      return true;
    }
    return false;
  }
#endif

#if defined(CREATE_INFO_eevee_Cryptomatte)
#line 108
  float2 _merge_sample(eevee_Cryptomatte  this_, FilmSample film_sample, float2 dst, float2 src)
  {
    float coverage = (dst.y * film_sample.weight + src.y) * film_sample.weight_sum_inv;

    if (coverage > 0.9999f) {
      coverage = 1.0f;
    }
    return float2(src.x, coverage);
  }
#endif
