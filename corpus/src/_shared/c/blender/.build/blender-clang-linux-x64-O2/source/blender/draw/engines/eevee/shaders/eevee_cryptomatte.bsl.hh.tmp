  void _clear_samples(eevee_Cryptomatte  this_, FilmSample dst)
  {
    int layer_len = imageSize(srt_access(eevee_Cryptomatte, cryptomatte_img)).z;
    for (int i = 0; i < layer_len; i++) {
      imageStoreFast(srt_access(eevee_Cryptomatte, cryptomatte_img), int3(dst.texel, i), float4(0.0f));

      imageFence(srt_access(eevee_Cryptomatte, cryptomatte_img));
    }
  }
#endif

