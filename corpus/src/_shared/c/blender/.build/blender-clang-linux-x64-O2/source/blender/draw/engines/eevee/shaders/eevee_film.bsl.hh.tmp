float4 eevee_film_safe_divide_even_color(float4 a, float4 b)
{
  a *= safe_rcp(b);

  if (b.x == 0.0f) {
    if (b.y == 0.0f) {
      a.x = a.z;
      a.y = a.z;
    }
    else if (b.z == 0.0f) {
      a.x = a.y;
      a.z = a.y;
    }
    else {
      a.x = 0.5f * (a.y + a.z);
    }
  }
  else if (b.y == 0.0f) {
    if (b.z == 0.0f) {
      a.y = a.x;
      a.z = a.x;
    }
    else {
      a.y = 0.5f * (a.x + a.z);
    }
  }
  else if (b.z == 0.0f) {
    a.z = 0.5f * (a.x + a.y);
  }
  return a;
}

