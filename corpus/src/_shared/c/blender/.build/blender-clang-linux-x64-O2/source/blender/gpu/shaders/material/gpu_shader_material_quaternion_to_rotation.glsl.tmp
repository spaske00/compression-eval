#line 8
void quaternion_to_rotation(float w, float x, float y, float z, _ref(float4 ,rotation))
{
  const float4 quat = float4(w, x, y, z);
  if (!is_zero(quat)) {
    rotation = normalize(quat);
  }
  else {
    rotation = float4(1.0f, 0.0f, 0.0f, 0.0f);
  }
}
