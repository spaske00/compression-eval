#pragma once

#include "workbench_defines.hh"

#define WORKBENCH_LIGHTING_STUDIO 0
#define WORKBENCH_LIGHTING_MATCAP 1
#define WORKBENCH_LIGHTING_FLAT 2



GPU_SHADER_CREATE_INFO(workbench_resolve_FragOut)
FRAGMENT_OUT(0, float4, workbench_resolve_FragOut_color)
GPU_SHADER_CREATE_END()



GPU_SHADER_CREATE_INFO(workbench_resolve_Resources)
.noop()

.noop()

.noop()

.noop()

ADDITIONAL_INFO(draw_view)
.sampler(3, ImageType::sampler2DDepth, "depth_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(4, ImageType::sampler2D, "normal_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(5, ImageType::sampler2D, "material_tx", Frequency::PASS, GPUSamplerState::internal_sampler())
.sampler(6, ImageType::usampler2D, "object_id_tx", Frequency::PASS, GPUSamplerState::internal_sampler(), [](blender::Span<CompilationConstant> constants) { int use_curvature = ShaderCreateInfo::find_constant(constants, "use_curvature"); return (use_curvature);})
.sampler(8, ImageType::usampler2D, "stencil_tx", Frequency::PASS, GPUSamplerState::internal_sampler(), [](blender::Span<CompilationConstant> constants) { int use_shadow = ShaderCreateInfo::find_constant(constants, "use_shadow"); return (use_shadow);})
.sampler(WB_MATCAP_SLOT, ImageType::sampler2DArray, "matcap_tx", Frequency::PASS, GPUSamplerState::internal_sampler(), [](blender::Span<CompilationConstant> constants) { int lighting_mode = ShaderCreateInfo::find_constant(constants, "lighting_mode"); return (lighting_mode == 1                                );})
.additional_info("workbench_World")
.additional_info_with_condition("workbench_Cavity", [](blender::Span<CompilationConstant> constants) { int use_cavity = ShaderCreateInfo::find_constant(constants, "use_cavity"); return (use_cavity);})
GPU_SHADER_CREATE_END()

GPU_SHADER_CREATE_INFO(workbench_resolve_vert_infos_)
BUILTINS(BuiltinBits::VERTEX_ID)
GPU_SHADER_CREATE_END()

GPU_SHADER_CREATE_INFO(workbench_resolve_frag_infos_)
BUILTINS(BuiltinBits::FRAG_COORD)
ADDITIONAL_INFO(workbench_resolve_Resources)
ADDITIONAL_INFO(workbench_resolve_FragOut)
GPU_SHADER_CREATE_END()

