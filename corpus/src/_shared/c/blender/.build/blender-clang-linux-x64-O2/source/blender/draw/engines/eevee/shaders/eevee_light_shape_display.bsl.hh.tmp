float eevee_light_shape_display_light_radiance_get(LightData light)
{
  if (is_sun_light(light.type)) {
    float radius = _sun(light).shape_radius;
    return M_1_PI * (1.0f + 1.0f / max(radius * radius, 1e-20f));
  }

  if (is_area_light(light.type)) {
    float area = _area(light).size.x * _area(light).size.y * 4.0f;
    if (light.type == LIGHT_ELLIPSE) {
      area *= M_PI * 0.25f;
    }
    return 1.0f / max(M_PI * area, 1e-20f);
  }

  float radius = _local(light).local.shape_radius;
  float area = 4.0f * M_PI * radius * radius;
  return 1.0f / max(M_PI * area, 1e-20f);
}

float3 eevee_light_shape_display_light_position_get(const ViewMatrices view, LightData light, float2 quad_pos)
{
  if (is_area_light(light.type)) {
    return transform_point(light.object_to_world, float3(quad_pos * _area(light).size, 0.0f));
  }

  float radius = _local(light).local.shape_radius;
  float3 center = _position(light);
  float3 view_right = view.viewinv[0].xyz;
  float3 view_up = view.viewinv[1].xyz;
  float3 L = center - _position(view);
  float dist = length(L);
  if (dist > 1e-8f) {
    L /= dist;
    make_orthonormal_basis(L, view_right, view_up);
  }

  if (is_sphere_light(light.type)) {
    if (dist > radius) {
      radius = light_sphere_disk_radius(radius, dist);
    }
    else {
      radius = _far(view);
    }
  }

  return center + (view_right * quad_pos.x + view_up * quad_pos.y) * radius;
}

float3 eevee_light_shape_display_far_plane_position_get(const ViewMatrices view, float2 ndc_pos)
{
  return _point_ndc_to_world(view, float3(ndc_pos, 1.0f));
}

float2 eevee_light_shape_display_quad_position_get(int vertex_id)
{
  int quad_vertex_id = vertex_id % 6;
  float x = (quad_vertex_id == 0 || quad_vertex_id == 2 || quad_vertex_id == 5) ? -1.0f : 1.0f;
  float y = (quad_vertex_id == 0 || quad_vertex_id == 1 || quad_vertex_id == 3) ? -1.0f : 1.0f;
  return float2(x, y);
}
