  bool _is_visible(workbench_shadow_visibility_Resources  this_, IsectBox box)
  {
    for (int i_plane = 0; i_plane < srt_access(workbench_shadow_visibility_Resources, extruded_frustum).planes_count; i_plane++) {
      float4 plane = srt_access(workbench_shadow_visibility_Resources, extruded_frustum).planes[i_plane];
      bool separating_axis = true;
      for (int i_corner = 0; i_corner < 8; i_corner++) {
        float signed_distance = dot(box.corners[i_corner], plane.xyz) - plane.w;
        if (signed_distance <= 0) {
          separating_axis = false;
          break;
        }
      }
      if (separating_axis) {
        return false;
      }
    }
    return true;
  }
#endif

#if defined(CREATE_INFO_workbench_shadow_visibility_Resources)
#line 61
  bool _intersects_near_plane(workbench_shadow_visibility_Resources  this_, IsectBox box)
  {
    float4 near_plane = drw_view_culling().frustum_planes.planes[4];
    bool on_positive_side = false;
    bool on_negative_side = false;

    for (int i_corner = 0; i_corner < 8; i_corner++) {
      for (int i_displace = 0; i_displace < 2; i_displace++) {
        float3 corner = box.corners[i_corner] + (srt_access(workbench_shadow_visibility_Resources, shadow_direction) * 1e5f * i_displace);
        float signed_distance = dot(corner, -near_plane.xyz) - near_plane.w;
        if (signed_distance <= 0) {
          on_negative_side = true;
        }
        else {
          on_positive_side = true;
        }
        if (on_negative_side && on_positive_side) {
          return true;
        }
      }
    }

    return false;
  }
#endif

