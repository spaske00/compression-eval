void node_displacement_object(float height, float midlevel, float scale, float3 N, _ref(float3 ,result))
{
  float3 lN;
  direction_transform_world_to_object(N, lN);
  float3 l_displacement = (height - midlevel) * scale * normalize(lN);

  direction_transform_object_to_world(l_displacement, result);
}
#line 18
void node_displacement_world(float height, float midlevel, float scale, float3 N, _ref(float3 ,result))
{
  result = (height - midlevel) * scale * normalize(N);
}
