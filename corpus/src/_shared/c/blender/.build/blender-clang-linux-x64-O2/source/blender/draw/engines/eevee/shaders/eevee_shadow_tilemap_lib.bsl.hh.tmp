ShadowCoordinates shadow_directional_coordinates_at_level(LightData light, float3 lP, int level)
{
#line 284
  int level_relative = level - _sun(light).clipmap_lod_min;
  int lod_relative = (light.type == LIGHT_SUN_ORTHO) ? _sun(light).clipmap_lod_min : level;

  int2 clipmap_offset = shadow_decompress_grid_offset(light.type,
                                                      _sun(light).clipmap_base_offset_neg,
                                                      _sun(light).clipmap_base_offset_pos,
                                                      level_relative);

  float2 tilemap_uv = lP.xy - _sun(light).clipmap_origin;
  tilemap_uv *= exp2(float(-lod_relative));
  tilemap_uv -= float2(clipmap_offset) * (1.0f / float(SHADOW_TILEMAP_RES));
  tilemap_uv = saturate(tilemap_uv + 0.5f);

  return shadow_coordinate_from_uvs(light.tilemap_index + level_relative, tilemap_uv);
}
