pointcloud_Point pointcloud_object_to_world(pointcloud_Point pt, float4x4 object_to_world)
{
  pt.P = transform_point(object_to_world, pt.P);
  pt.radius *= length(to_scale(object_to_world)) * M_SQRT1_3;
  return pt;
}

struct pointcloud_ShapePoint {

  float3 P;

  float3 N;
};
#line 81
