pointcloud_Point pointcloud_point_get(uint vert_id)
{

#if defined(CREATE_INFO_draw_pointcloud)
#line 38
  pointcloud_Point pt;
  pt.point_id = pointcloud_point_id_get(vert_id);
#line 42
  float4 pos_rad = texelFetch(sampler_get(draw_pointcloud, ptcloud_pos_rad_tx), pt.point_id);
  pt.P = pos_rad.xyz;
  pt.radius = pos_rad.w;
  pt.shape_pos = float3(NAN_FLT);
  switch (vert_id % DRW_POINTCLOUD_STRIP_TILE_SIZE) {
    case 0:
      pt.shape_pos = float3(-1.0, 0.0, 0.0);
      break;
    case 1:
      pt.shape_pos = float3(0.0, -1.0, 0.0);
      break;
    case 2:
      pt.shape_pos = float3(0.0, 0.0, 1.0);
      break;
    case 3:
      pt.shape_pos = float3(1.0, 0.0, 0.0);
      break;
    case 4:
      pt.shape_pos = float3(0.0, 0.0, 1.0);
      break;
    case 5:
      pt.shape_pos = float3(0.0, 1.0, 0.0);
      break;
    case 6:
      pt.shape_pos = float3(-1.0, 0.0, 0.0);
      break;
    default:
      break;
  }
  return pt;

