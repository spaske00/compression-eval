#line 88
float3x3 pointcloud_facing_matrix(const float3 V, const float3 up_axis)
{
  float3x3 facing_mat;
  facing_mat[2] = V;
#ifdef MAT_GEOM_POINTCLOUD
  if (ptcloud_backface) {
    facing_mat[2] = -facing_mat[2];
  }
#endif
  facing_mat[1] = normalize(cross(up_axis, facing_mat[2]));
  facing_mat[0] = cross(facing_mat[1], facing_mat[2]);
  return facing_mat;
}
#line 107
pointcloud_ShapePoint pointcloud_shape_point_get(const pointcloud_Point pt,
                           const float3 V,
                           const float3 up_axis,
                           const eObjectInfoFlag ob_flag)
{
  pointcloud_ShapePoint shape;
  shape.N = pointcloud_facing_matrix(V, up_axis) * pt.shape_pos;
  if (flag_test(ob_flag, OBJECT_NEGATIVE_SCALE)) {
    shape.N = -shape.N;
  }
  shape.P = pt.P + shape.N * pt.radius;
  return shape;
}

