float pointcloud_get_customdata_float(const int point_id, const samplerBuffer cd_buf)
{
  return texelFetch(cd_buf, point_id).r;
}

float2 pointcloud_get_customdata_vec2(const int point_id, const samplerBuffer cd_buf)
{
  return texelFetch(cd_buf, point_id).rg;
}

float3 pointcloud_get_customdata_vec3(const int point_id, const samplerBuffer cd_buf)
{
  return texelFetch(cd_buf, point_id).rgb;
}

float4 pointcloud_get_customdata_vec4(const int point_id, const samplerBuffer cd_buf)
{
  return texelFetch(cd_buf, point_id).rgba;
}

