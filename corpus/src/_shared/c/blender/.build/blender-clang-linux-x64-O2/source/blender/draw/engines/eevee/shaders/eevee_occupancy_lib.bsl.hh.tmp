occupancy_Bits occupancy_resolve(occupancy_Bits entry, occupancy_Bits exit, int bit_count)
{
  occupancy_Bits occupancy;
  for (int j = 0; j < 8; j++) {
    for (int i = 0; i < 32; i++) {
