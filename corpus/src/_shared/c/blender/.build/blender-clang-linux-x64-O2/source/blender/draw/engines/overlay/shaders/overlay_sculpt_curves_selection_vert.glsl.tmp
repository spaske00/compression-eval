VERTEX_SHADER_CREATE_INFO(overlay_sculpt_curves_selection)
#line 14
float retrieve_selection(const curves_Point pt)
{
  if (is_point_domain) {
    return texelFetch(selection_tx, pt.point_id).r;
  }
  return texelFetch(selection_tx, pt.curve_id).r;
}

#if defined(GPU_NVIDIA) && defined(GPU_OPENGL)

#  define const
#endif

void main()
{
  const curves_Point ls_pt = curves_point_get(uint(gl_VertexID));
  const curves_Point ws_pt = curves_object_to_world(ls_pt, drw_modelmat());
  float3 world_pos = curves_shape_point_get(ws_pt, drw_world_incident_vector(ws_pt.P)).P;

  gl_Position = drw_point_world_to_homogenous(world_pos);

  mask_weight = 1.0f - (selection_opacity - retrieve_selection(ws_pt) * selection_opacity);

  view_clipping_distances(world_pos);
}
