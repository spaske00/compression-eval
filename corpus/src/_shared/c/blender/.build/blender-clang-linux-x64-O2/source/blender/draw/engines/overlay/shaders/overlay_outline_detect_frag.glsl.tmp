void diag_dir(bool4 edges1, bool4 edges2, _ref(float2 ,line_start), _ref(float2 ,line_end))
{

  edges2 = not(edges2);
  edges2 = rotate_180(edges2);
  line_end = diag_offset(edges1);
  line_end += diag_offset(edges2);

