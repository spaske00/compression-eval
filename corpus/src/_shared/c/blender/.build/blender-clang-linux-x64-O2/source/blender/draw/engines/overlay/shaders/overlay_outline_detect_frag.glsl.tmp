bool line_offset(bool2 edges, float2 ofs, _ref(float2 ,line_point))
{
  if (all(edges.xy)) {
    line_point.y -= ofs.y;
  }
  else if (!edges.x) {
    line_point.y += ofs.y;
  }
  else                {
    line_point.x += ofs.x;
    return true;
  }
  return false;
}
