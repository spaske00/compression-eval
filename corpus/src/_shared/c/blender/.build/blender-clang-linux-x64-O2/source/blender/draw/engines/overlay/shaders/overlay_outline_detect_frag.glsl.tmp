    line_start = float2(-1.0f, 1.0f) * PROXIMITY_OFS * 0.4f;
  }
  else if (line_end.x > line_end.y) {

    line_start = float2(0.0f, PROXIMITY_OFS);
  }
  else {

    line_start = -float2(PROXIMITY_OFS, 0.0f);
  }
  line_end += line_start;
}

