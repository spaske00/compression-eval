float volume_phase_function_isotropic()
{
  return 1.0f / (4.0f * M_PI);
}

float volume_phase_function(float3 V, float3 L, float g)
{

  float cos_theta = dot(V, L);
  g = clamp(g, -1.0f + 1e-3f, 1.0f - 1e-3f);
  float sqr_g = g * g;
  return (1 - sqr_g) / max(1e-8f, 4.0f * M_PI * pow(1 + sqr_g - 2 * g * cos_theta, 3.0f / 2.0f));
}

SphericalHarmonicL1Tfloat4 volume_phase_function_as_sh_L1(float3 V, float g)
{
#line 198
  SphericalHarmonicL1Tfloat4 sh;
  sh.L0.M0 = spherical_harmonics_L0_M0_coef(V) * float4(1.0f);
  sh.L1.Mn1 = spherical_harmonics_L1_Mn1_coef(V) * float4(g);
  sh.L1.M0 = spherical_harmonics_L1_M0_coef(V) * float4(g);
  sh.L1.Mp1 = spherical_harmonics_L1_Mp1_coef(V) * float4(g);
  return sh;
}

