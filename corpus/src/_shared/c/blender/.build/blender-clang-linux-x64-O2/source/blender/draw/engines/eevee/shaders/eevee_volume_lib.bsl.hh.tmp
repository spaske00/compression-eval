float volume_z_to_view_z(const eevee_Uniform  uni,
                         const ViewMatrices view,
                         float z)
{
  float near = srt_access(eevee_Uniform, uniform_buf).volumes.depth_near;
  float far = srt_access(eevee_Uniform, uniform_buf).volumes.depth_far;
  float distribution = srt_access(eevee_Uniform, uniform_buf).volumes.depth_distribution;
  if (_is_perspective(view)) {

    return (exp2(z / distribution) - near) / far;
  }
  else {

    return near + (far - near) * z;
  }
}
#endif
#line 53
float view_z_to_volume_z(
    const ViewMatrices view, float depth, float near, float far, float distribution)
{
  if (_is_perspective(view)) {

    return distribution * log2(max(1e-8, depth * far + near));
  }
  else {

    return (depth - near) / (far - near);
  }
}

