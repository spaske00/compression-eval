#!/usr/bin/env bash
set -euo pipefail
if (( $# < 3 )); then echo "usage: $0 CC CXX TARGET_NAME [FLAGS ...]" >&2; exit 2; fi
cc=$1; cxx=$2; raw=$3; shift 3; flags=("$@"); target=${raw%.out}
case "$target" in ""|.|..|*/*) exit 2;; esac
case "$(basename "$cc"):$(basename "$cxx")" in gcc*:g++*|clang*:clang++*) ;; *) exit 2;; esac
root=$(cd "$(dirname "$0")" && pwd); build="$root/.build/$target"; src="$build/source"; tmp="$root/bin/.$target.tmp"; out="$root/bin/$target"
trap 'rm -rf -- "$tmp"' EXIT; rm -rf -- "$build" "$tmp" "$out"; mkdir -p "$src" "$tmp"
git -C "$root/upstream" archive HEAD | tar -xf - -C "$src"
make -C "$src" -j"${JOBS:-8}" CC="$cc" CXX="$cxx" CFLAGS="${flags[*]}" LDFLAGS="${flags[*]}" MALLOC=libc BUILD_TLS=no BUILD_WITH_MODULES=no redis-server
artifact="$src/src/redis-server"; test -s "$artifact" -a -x "$artifact"; test "$(dd if="$artifact" bs=4 count=1 status=none)" = "$(printf '\177ELF')"
cp "$artifact" "$tmp/$target"; chmod u+x "$tmp/$target"; mv -T "$tmp" "$out"; trap - EXIT
