#!/bin/bash
#shellcheck disable=SC2164

set -euo pipefail

cc="$1"
cxx="$2"
target="${3#"sqlite-"}"
shift 3
cflags="$*"
target_name="sqlite-${target%.out}"

sqlite_root="$PWD"
sqlite_src="$sqlite_root/sqlite-3.51.1"
build_dir="$sqlite_src/build-$target_name"
configure_args=()

if [[ " $cflags " == *" -static "* ]]; then
    configure_args+=("--static-cli-shell" "--disable-readline")
fi

mkdir -p "$sqlite_root/bin" "$build_dir"

cd "$build_dir"
if [[ -f Makefile ]]; then
    MAKEFLAGS= make clean
fi
../configure "${configure_args[@]}" CC="$cc" CXX="$cxx" CFLAGS="$cflags" CXXFLAGS="$cflags" LDFLAGS="$cflags"
MAKEFLAGS= make sqlite3 -j"${JOBS:-8}"

target_dir="$sqlite_root/bin/$target_name/"
mkdir -p "$target_dir"
cp ./sqlite3 "$target_dir/$target_name"

if [[ ! -x "$target_dir/$target_name" ]]; then
    echo "Expected SQLite executable at $target_dir/$target_name" >&2
    exit 1
fi

unset cc
unset cxx
unset target
unset target_name
unset configure_args
unset build_dir
unset sqlite_src
unset target_dir
unset cflags
unset sqlite_root
