#!/bin/bash
#shellcheck disable=SC2164

source ../../utils.sh

arch=(
    "linux-x64"
)

declare -A opts=(
    ["O0"]="-O0"
    ["O1"]="-O1"
    ["O2"]="-O2"
    ["O3"]="-O3"
    ["Of"]="-Ofast"
    ["Os"]="-Os"
    ["Og"]="-Og"
    ["debug"]="-g"
    ["static"]="-static"
    # ["static-pie"]="-static-pie"
)

function move_bins ()
{
    shopt -s nullglob
    local entries=(bin/*)
    if (( ${#entries[@]} == 0 )); then
        return 0
    fi

    mkdir -p "$__BASE_DIR/bin"
    for entry in "${entries[@]}"; do
        local dest="$__BASE_DIR/bin/$(basename "$entry")"
        if [[ -d "$entry" && -d "$dest" ]]; then
            if rm -rf "$dest" 2>/dev/null; then
                mv "$entry" "$dest" || return $?
            else
                cp -Rf "$entry"/. "$dest"/ 2>/dev/null || cp -Rn "$entry"/. "$dest"/ || return $?
                rm -rf "$entry" || return $?
            fi
        else
            mv -f "$entry" "$dest" || return $?
        fi
    done
}

status=0
COMPILER_LABEL=gcc loop_dirs make_all gcc-14 g++-14 || status=$?
loop_dirs move_bins || status=$?

unset arch
unset opts

exit "$status"
