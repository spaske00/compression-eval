debug_runner=./target/getting-started-1.0.0-SNAPSHOT-native-image-source-jar/getting-started-1.0.0-SNAPSHOT-runner.debug

if [[ -x "$debug_runner" && ( -z "$marker" || "$debug_runner" -nt "$marker" ) ]]; then
    mv ./target/getting-started-1.0.0-SNAPSHOT-native-image-source-jar/getting-started-1.0.0-SNAPSHOT-runner.debug ./target/image.debug
elif [[ -x "$runner" && ( -z "$marker" || "$runner" -nt "$marker" ) ]]; then
    mv ./target/getting-started-1.0.0-SNAPSHOT-runner ./target/image
fi
