#!/bin/bash

py="${1:-python}"
plots_dir="plots"

mkdir -p "$plots_dir"
shopt -s nullglob

metrics=(
    "Compression speed"
    "Decompression speed"
    "Ratio"
)


# Silesia

for m in "${metrics[@]}"; do
    "$py" plot_metrics.py silesia.csv "$m" 
done

"$py" plot_bubble.py silesia.csv "${metrics[2]}" "${metrics[0]}" "Compressor name" "Original size" "Filename"
"$py" plot_bubble.py silesia.csv "${metrics[2]}" "${metrics[1]}" "Compressor name" "Original size" "Filename"
"$py" plot_bubble.py silesia.csv "${metrics[0]}" "${metrics[1]}" "Compressor name" "Original size" "Filename"

# Nexus

for c in "graalvm-linux-x64-O2" "dotnet-linux-x64-release" "gcc-linux-x64-O2"; do
    for m in "${metrics[@]}"; do
        "$py" plot_metrics.py nexus.csv "$m" "$c"
    done
    "$py" plot_bubble.py nexus.csv "${metrics[2]}" "${metrics[0]}" "Compressor name" "Original size" "Filename" "$c"
    "$py" plot_bubble.py nexus.csv "${metrics[2]}" "${metrics[1]}" "Compressor name" "Original size" "Filename" "$c"
    "$py" plot_bubble.py nexus.csv "${metrics[0]}" "${metrics[1]}" "Compressor name" "Original size" "Filename" "$c"
done

pdfs=(*.pdf)
if ((${#pdfs[@]})); then
    mv -f "${pdfs[@]}" "$plots_dir"/
fi
